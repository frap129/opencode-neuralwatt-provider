{
  "name": "opencode-neuralwatt-provider",
  "version": "1.0.1",
  "description": "Neuralwatt provider for OpenCode",
  "author": {
    "name": "Joe Maples",
    "email": "joe@maples.dev"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frap129/opencode-neuralwatt-provider"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/version.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target bun --external @ai-sdk/openai-compatible --external @opencode-ai/plugin --external @opencode-ai/sdk && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@opencode-ai/plugin": "^1.4.7",
    "@opencode-ai/sdk": "^1.4.7",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "bun-types": "latest",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {},
  "peerDependencies": {
    "@ai-sdk/openai-compatible": ">=0.1",
    "@opencode-ai/plugin": "^1.4.7",
    "@opencode-ai/sdk": "^1.4.7"
  }
}
